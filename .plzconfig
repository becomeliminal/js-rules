[please]
version = >=17.27.0

[PluginDefinition]
name = js

[PluginConfig "node_tool"]
ConfigKey = NodeTool
DefaultValue = ///js//third_party/node:node|node
Help = Build label for the Node.js binary. Defaults to a toolchain from node-rules.
Inherit = true

[PluginConfig "please_js_tool"]
ConfigKey = PleaseJsTool
DefaultValue = //tools/please_js
Help = Build label for the please_js companion tool.
Inherit = true

[PluginConfig "node_modules"]
ConfigKey = NodeModules
DefaultValue = //third_party/js:node_modules
Help = Build label for the third-party node_modules tree, from npm_link. Rules take it by default so a single-tree repo never names it.
Optional = true
Inherit = true

[PluginConfig "npm_registry"]
ConfigKey = NpmRegistry
DefaultValue = https://registry.npmjs.org
Help = Registry that npm_repo fetches package tarballs from.
Inherit = true

[Plugin "go"]
Target = //plugins:go
gotool = //third_party/go:gotool|go

[Plugin "node"]
Target = //plugins:node
NodeTool = //third_party/node:node|node

# This repo is the js plugin, so its own defaults would point at a subrepo
# self-reference. Point them at the local targets instead.
[Plugin "js"]
NodeTool = //third_party/node:node|node
PleaseJsTool = //tools/please_js
NodeModules = //third_party/js:node_modules

; plz only aggregates coverage for known file extensions, and JavaScript's are
; not in its default list -- the same constraint rust-rules documents for .rs.
; A consuming repo needs these lines too.
[cover]
fileextension = .js
fileextension = .jsx
fileextension = .mjs
fileextension = .cjs
fileextension = .ts
fileextension = .tsx
