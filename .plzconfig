[please]
version = >=17.27.0

[PluginDefinition]
name = js

[PluginConfig "node_tool"]
ConfigKey = NodeTool
DefaultValue = ///js//third_party/node:node|node
Help = Build label for the Node.js binary. Defaults to a toolchain from node-rules.
Inherit = true

[PluginConfig "please_js_tool"]
ConfigKey = PleaseJsTool
DefaultValue = //tools/please_js
Help = Build label for the please_js companion tool.
Inherit = true

[PluginConfig "node_modules"]
ConfigKey = NodeModules
DefaultValue = //third_party/js:node_modules
Help = Build label for the third-party node_modules tree, from npm_link. Rules take it by default so a single-tree repo never names it.
Optional = true
Inherit = true

[PluginConfig "tree"]
ConfigKey = Tree
DefaultValue = //third_party/js
Help = Package of the repo's pnpm workspace tree: the lockfile, its generated BUILD file, and the data npm_project reads. npm_project takes it by default so a repo with one tree never names it.
Optional = true
Inherit = true

[PluginConfig "tree_repo"]
ConfigKey = TreeRepo
DefaultValue =
Help = The subrepo an npm_workspace in the Tree package generates its npm_repo pins into, e.g. npm. Empty means the pins are in the Tree package's own BUILD file, generated by npm_update.
Optional = true
Inherit = true

[PluginConfig "npm_registry"]
ConfigKey = NpmRegistry
DefaultValue = https://registry.npmjs.org
Help = Registry that npm_repo fetches package tarballs from.
Inherit = true

[Plugin "go"]
Target = //plugins:go
gotool = //third_party/go:gotool|go

[Plugin "node"]
Target = //plugins:node
NodeTool = //third_party/node:node|node

# This repo is the js plugin, so its own defaults would point at a subrepo
# self-reference. Point them at the local targets instead.
[Plugin "js"]
NodeTool = //third_party/node:node|node
PleaseJsTool = //tools/please_js
NodeModules = //third_party/js:node_modules
; The fixture workspace, so test/project/app's bare npm_project() exercises the
; config path -- including Please's canonicalisation of a package-shaped value
; into a label -- exactly as a consuming repo does. Nothing else here reads it.
Tree = //test/project/tree

; plz only aggregates coverage for known file extensions, and JavaScript's are
; not in its default list -- the same constraint rust-rules documents for .rs.
; A consuming repo needs these lines too.
[cover]
fileextension = .js
fileextension = .jsx
fileextension = .mjs
fileextension = .cjs
fileextension = .ts
fileextension = .tsx

; plz lint: ESLint over this repository's JavaScript and TypeScript.
[alias "lint"]
desc = Lints the JavaScript and TypeScript in this repository
cmd = run //tools/eslint -- .
