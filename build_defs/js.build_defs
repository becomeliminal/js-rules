"""Running JavaScript under Please.

The rules here mirror the shape every Please plugin has: npm_repo for a
third-party package, js_library for a first-party one, js_binary for something
that runs -- the same triple as go_repo/go_library/go_binary and
rust_repo/rust_library/rust_binary.

One thing JavaScript makes harder than Go or Rust. Both of those name a
first-party library and hand the compiler a table mapping that name to a path:
an importconfig for `go tool compile`, `--extern` flags for rustc. Node accepts
no such table -- it resolves only by walking the filesystem -- so the table has
to be the directory. A first-party library is therefore named by where it lives,
as a Go import path mirrors its directory, and placed in the tree under that
name.
"""


def js_library(name:str, srcs:list, deps:list=[], types:list=[], data:list=[],
               package:str="", visibility:list=None,
               test_only:bool&testonly=False, labels:list=[]):
    """A first-party JavaScript library.

    Runs no actions beyond arranging its sources: compilation belongs to
    ts-rules, so a library of plain JavaScript costs nothing to declare.

    Args:
        name: Target name.
        srcs: Source files.
        deps: Other js_library targets, and npm_repo targets for third-party
              packages. First-party deps are exported, so a binary depending on
              this library also gets the libraries it needs -- affordable here
              because a first-party graph is tens of targets, where carrying a
              third-party closure the same way cost 50s of warm build.
        types: Declaration files this library ships, kept separate from srcs.

            A .d.ts is read by a compiler and by nothing else: a bundler never
            looks at one, and neither does node. Recording them apart is what
            lets a type-check depend on them while a bundle does not, so
            editing a declaration stops invalidating a bundle that could not
            have been affected by it.
        data: Files the library needs at runtime but no compiler should see --
              a JSON fixture, an image, a template. Copied in verbatim.

            Separate from srcs for the same reason and the opposite direction:
            a data file appearing among a compiler's inputs is a cache
            invalidation nobody asked for.
        package: The name source code imports this by. Defaults to the package
                 path, as Go derives an import path from the directory:
                 //common/js/components is imported as "common/js/components".
        visibility: Visibility specification.
        test_only: If True, only visible to test rules.
        labels: Additional labels.
    """
    package = package or package_name()
    check_package_name(package, name)
    entry = "index.js"
    pkg_dir = package_name()
    strip_len = len(pkg_dir) + 1 if pkg_dir else 0
    src_rel = [f[strip_len:] if f.startswith(pkg_dir + "/") else f for f in srcs + data]

    strip = package_name() + "/"

    return build_rule(
        name = name,
        srcs = {"srcs": srcs, "types": types, "data": data},
        outs = [name],
        cmd = " && ".join([
            'mkdir -p "$OUT/pkg"',
            # One placement for all three: they differ in what may read them,
            # not in where they land. A consumer sees one package.
            'for s in ${SRCS_SRCS:-} ${SRCS_TYPES:-} ${SRCS_DATA:-}; do ' +
            'mkdir -p "$OUT/pkg/$(dirname "${s#' + strip + '}")" && ' +
            'cp "$s" "$OUT/pkg/${s#' + strip + '}"; done',
            " ".join([
                "$TOOLS_PLEASE_JS describe",
                f"--name {name} --package {package} --version 0.0.0",
                f"--main {entry}",
                # Where the sources live, for a development server that serves
                # them instead of this built output. Data files are included --
                # a library reads them at runtime -- and types are not, since
                # nothing serves a declaration.
                f"--src-dir {pkg_dir} --src-entry {entry}",
                " ".join([f"--src {f}" for f in src_rel]),
                '--dir "$OUT/pkg" --out "$OUT/lib.json"',
            ]),
        ]),
        tools = {"please_js": [CONFIG.JS.PLEASE_JS_TOOL]},
        deps = deps,
        exported_deps = deps,
        visibility = visibility,
        test_only = test_only,
        labels = labels + [f"js_library:{package}"],
        building_description = "Arranging...",
    )


def js_binary(name:str, entry_point:str="", srcs:list=[], deps:list=[],
              runner:str="", runner_args:list=[], link_srcs:list=[],
              link_deps:bool=False,
              node_modules:str="", node_options:list=[], env:dict={},
              fixed_args:list=[], chdir:str="",
              visibility:list=None, labels:list=[]):
    """A JavaScript program run under node.

    Args:
        name: Target name.
        entry_point: The file node runs, relative to this package. Exactly one
                     of this and runner.
        srcs: Files staged beside the program, at their own paths. Only useful
              with a runner, which finds its own inputs.
        runner: An npm package providing the program, as "package" or
                "package|bin". The same argument js_test takes, for the same
                reason: a tool from the tree is resolved at run time, from the
                tree it will resolve everything else through.
        link_srcs: Files symlinked from the repository rather than copied, so
                   the program reads what the developer saves.

            For a program that has to see edits made after it started -- a
            development server is the only real case -- and deliberately narrow.
            Everything Please generates still lives in plz-out; these links live
            there and point at the source tree, never the other way round.

            Separate from srcs because the two are read differently. A config
            file is read once at startup, and it must be copied: node loads it
            by its real path, so a symlinked one resolves its own imports from
            the source tree, where there is no node_modules. Served content is
            read continuously, and must be linked, or an edit changes nothing.

            Linked at run time, because a build action is sandboxed and sees
            temporary paths, and a symlink to one of those is dead the moment
            the action ends.
        link_deps: Serve first-party dependencies from their sources rather
                   than their built output.

            The dev half of the same split link_srcs draws for the program's own
            files: in development a package is its sources, and the server
            transforms them like anything else it serves. Each library records
            where its sources live in its lib.json -- the only channel, since a
            rule sees nothing of its dependencies but their outputs -- and the
            launcher materialises them at start-up, for the same reason
            link_srcs links at run time: a symlink made in a sandboxed action
            points at a path that dies with the action.

            Requires runner: the only program that wants this is one serving the
            files, and it needs the tree the links land in.
        deps: js_library targets whose packages this program imports.
        node_modules: The third-party tree, from npm_link. Defaults to the
                      NodeModules config, so a single-tree repo never names it.
        node_options: Flags passed to node.
        env: Environment for the program, set before it starts.

            There is deliberately no env_inherit here, though rules_js has one.
            It has nothing to do in Please: `plz run` already passes the
            caller's whole environment through, and `plz test` passes none of
            it and gives the launcher nothing to re-export. Bazel needs the
            argument because Bazel scrubs the environment; a no-op argument
            that looks like it does something is worse than its absence.
        fixed_args: Arguments the program always receives, before any the caller
                    gives. That ordering is what makes them fixed -- a wrapper's
                    own arguments cannot be displaced by whoever runs it.
        chdir: Directory to run in, relative to the repo root. Node resolves
               from the entry point rather than the working directory, so this
               changes where the program looks for files and not what it can
               import.
        visibility: Visibility specification.
        labels: Additional labels.
    """
    if bool(entry_point) == bool(runner):
        fail(f"js_binary {name}: set exactly one of entry_point or runner")
    if link_deps and not runner:
        fail(f"js_binary {name}: link_deps serves dependencies to a runner, and there is none")

    return _js_run(name, entry_point, deps, node_modules, node_options,
                   test = False, visibility = visibility, labels = labels,
                   srcs = srcs, runner = runner, runner_args = runner_args,
                   link_srcs = link_srcs, link_deps = link_deps,
                   env = env, fixed_args = fixed_args, chdir = chdir)


def js_test(name:str, entry_point:str="", srcs:list=[], deps:list=[],
            data:list=[], runner:str="", runner_args:list=[],
            node_modules:str="", node_options:list=[], env:dict={},
            fixed_args:list=[], chdir:str="", expected_exit_code:int=0,
            visibility:list=None, labels:list=[],
            timeout:int=0, flaky:bool|int=0, size:str=None):
    """A JavaScript test, either a suite or a program.

    Two modes, because a test is one of two things and they report differently.

    Pass `srcs` and node's own test runner runs them, writing JUnit for Please
    to read, so each test is named in the output rather than the whole file
    being one result. Nothing is installed for this: the runner is part of the
    runtime node-rules already pins, which is what lets a test of these rules
    avoid depending on the tree these rules build. go_test uses stdlib testing
    and rust_test uses built-in #[test] for the same reason.

    Pass `entry_point` and the program runs, passing if it exits as expected.
    That is how a command line tool's failure path gets tested, and how a
    built artifact -- a bundle, a compiled file -- gets run to prove it works.

    Args:
        name: Target name.
        entry_point: The file node runs, relative to this package. Exactly one
                     of this and srcs.
        srcs: Test files, run by node's test runner. Named individually rather
              than discovered, so a file the rule was not given cannot be picked
              up by accident.
        runner: An npm package providing the test runner, as "package" or
                "package|bin" where a package publishes several.

            Empty means node's own runner, which needs nothing installed and is
            what the rules here test themselves with -- a test of npm_link
            cannot come from a tree npm_link built.

            Named, and everything else follows: vitest, jest and mocha all
            write JUnit and all take a file to write it to, so a runner is a
            package name and a few flags rather than a rule of its own.
        runner_args: Flags for that runner. $RESULTS_FILE expands to the path
                     Please reads results from, which is only known at test
                     time, so a reporter is pointed at it here rather than in
                     an output.
        data: Targets the test reads rather than imports -- a built package, a
              bundle, a compiled file. They stage at their package paths, and
              the test's working directory is the staging root, so a test asserts
              on `test/thing/built.js` by that name.

              Separate from deps because these are not modules: a test that
              checks what a rule produced is reading an artifact, not importing
              a library.
        deps: js_library targets whose packages this test imports.
        node_modules: The third-party tree, from npm_link.
        node_options: Flags passed to node.
        env: Environment for the test, set before it starts. A test gets a
             clean environment from Please, so this is the whole of it.
        fixed_args: Arguments the test always receives.
        chdir: Directory to run in, relative to the repo root.
        expected_exit_code: The status the program is expected to exit with.

            How a command line tool's failure paths get tested: a program that
            exits 1 because it correctly rejected its input has passed, and one
            that exits 0 has not.
        visibility: Visibility specification.
        labels: Additional labels.
        timeout: Test timeout in seconds.
        flaky: True to mark the test flaky, or an integer for reruns.
        size: Test size.
    """
    if bool(entry_point) == bool(srcs):
        fail(f"js_test {name}: set exactly one of entry_point or srcs")
    if srcs and expected_exit_code:
        fail(f"js_test {name}: expected_exit_code asks whether a program exited " +
             "as expected, which a suite does not answer -- a failing test is " +
             "reported as a failing test")

    return _js_run(name, entry_point, deps, node_modules, node_options,
                   test = True, visibility = visibility, labels = labels,
                   srcs = srcs, data = data, runner = runner,
                   runner_args = runner_args, env = env,
                   fixed_args = fixed_args, chdir = chdir,
                   expected_exit_code = expected_exit_code,
                   timeout = timeout, flaky = flaky, size = size)


def js_run_binary(name:str, package:str, bin:str="", tool_modules:str="",
                  deps:list=[], node_modules:str="",
                  srcs:list=[], outs:list=[],
                  out_dirs:list=[], args:list=[], env:dict={}, chdir:str=None,
                  stdout:str="", stderr:str="", exit_code_out:str="",
                  silent_on_success:bool=False,
                  visibility:list=None, labels:list=[], test_only:bool&testonly=False):
    """Runs an executable published by an npm package as a build action.

    The keystone: every compiler, bundler and test runner above this layer is a
    wrapper over it. The tool runs with node_modules staged beside its sources,
    so the tool's own module resolution -- which a build system cannot intercept
    -- works unchanged.

    Args:
        name: Target name.
        package: The npm package publishing the executable.
        bin: Which executable, as the package's own package.json declares it.
             Needed only where a package publishes several. Looked up rather
             than given as a path, so a typo fails the build with a message
             listing what the package does publish.
        tool_modules: The tree publishing the executable, when that is not the
                      same tree the sources resolve through. A bundler is the
                      case that forces this: it is itself an npm package, and so
                      are the packages it bundles, but a tree cannot hold two
                      entries claiming one name -- and every consumer bundling a
                      real application has their own copy of it. Defaults to
                      node_modules, which is right for a tool a repo installed
                      itself.
        deps: js_library and ts_library targets the tool should be able to
              import, overlaid onto the third-party tree. A bundler, a test
              runner and a linter all need to see first-party code, and without
              this they can only see what the lockfile provides.
        node_modules: The tree the tool resolves through. Optional: a
                      self-contained tool needs none, which is how pnpm itself
                      runs before any tree exists.
        srcs: Input files, staged alongside.
        outs: Files the tool is expected to produce.
        out_dirs: Directories the tool is expected to produce.
        args: Arguments passed to the executable.
        env: Environment variables for the action.
        stdout: Capture the tool's standard output to this file, declared as an
                output. How you snapshot-test a command line tool.
        stderr: Capture standard error the same way.
        exit_code_out: Capture the exit status to this file instead of failing
                       the action.

            This changes the rule's contract, so it is explicit: without it a
            non-zero exit is a build failure, which is the right default. With
            it the tool is expected to fail sometimes and the status is the
            thing being recorded.
        silent_on_success: Show the tool's output only if it fails. A large
                           build's log is worth reading, and most tools are
                           chatty about succeeding.
        chdir: Directory to run in. Defaults to the package directory, so args
               read relative to the BUILD file. node_modules sits at the staged
               root and is still found, because node's resolution walks up.
        visibility: Visibility specification.
        labels: Additional labels.
        test_only: If True, only visible to test rules.
    """
    node_modules = node_modules or CONFIG.JS.NODE_MODULES
    run_dir = "_run"
    # Kept apart on disk, not merged. The store already makes each tree resolve
    # correctly on its own: a package's dependencies are siblings inside its own
    # store entry, so a tool resolving from its own path never walks up into the
    # sources' tree, and the sources resolve upward from where they are staged.
    tool_dir = "_tool/node_modules"
    bin_tree = tool_dir if tool_modules else run_dir + "/node_modules"
    chdir = package_name() if chdir == None else chdir
    workdir = f"{run_dir}/{chdir}" if chdir else run_dir
    # Single-quoted, so a value containing a space, a $ or a backtick reaches
    # the tool as written rather than being split or expanded by the shell. The
    # inner replacement is the standard way to carry a single quote through
    # single quotes: close, escape one, reopen.
    # Captured streams are outputs like any other: a file the tool writes and
    # the rule does not declare is a file Please deletes. Counted before the
    # guard below, so a rule that captures output and produces nothing else is
    # still doing something.
    outs = outs + [f for f in [stdout, stderr, exit_code_out] if f]

    if not outs and not out_dirs:
        fail(f"js_run_binary {name}: declare outs or out_dirs, or the action has no effect")

    # Buffered when silent, so a successful tool says nothing and a failing one
    # still says everything -- losing diagnostics on failure is the only way
    # this could hurt.
    log = "_run.log"
    redirect = ""
    if stdout:
        redirect += f' > "{stdout}"'
    elif silent_on_success:
        redirect += f' > "{log}"'
    if stderr:
        redirect += f' 2> "{stderr}"'
    elif silent_on_success:
        redirect += f' 2>> "{log}"'

    # Without exit_code_out a non-zero exit fails the action, which is the right
    # default: a tool that failed did not produce what was asked for.
    status = ""
    if exit_code_out:
        status = f' && echo 0 > "{exit_code_out}" || echo $? > "{exit_code_out}"'
    elif silent_on_success:
        status = f' || {{ cat "{log}" >&2; exit 1; }}'

    env_prefix = " ".join([
        k + "='" + v.replace("'", "'\\''") + "'" for k, v in sorted(env.items())
    ])

    return build_rule(
        name = name,
        srcs = {
            "modules": [node_modules] if node_modules else [],
            "tool": [tool_modules] if tool_modules else [],
            "srcs": srcs,
        },
        outs = outs + out_dirs,
        output_dirs = out_dirs,
        cmd = " && ".join([
            'PLEASE_JS=$(readlink -f "$TOOLS_PLEASE_JS")',
            # Collected by shape, before the sources are staged: every
            # first-party library describes itself in a lib.json, so nothing has
            # to be named twice. node_modules is pruned because a staged tree
            # holds none of them and walking it doubles the work.
            'LIBS=$(find . -name node_modules -prune -o -name lib.json -print | ' +
            'while read m; do printf -- "--lib %s:%s " "$m" "$(dirname "$m")/pkg"; done)',
            # One tree, assembled by the same tool js_binary uses. A repo with no
            # third-party dependencies has no tree to overlay onto and the
            # overlay makes an empty one, so this path does not need a special
            # case for it.
            f'"$PLEASE_JS" overlay --tree "${{SRCS_MODULES:-}}" --out {run_dir}/node_modules $LIBS',
            f'for s in ${SRCS_SRCS:-}; do mkdir -p "{run_dir}/$(dirname "$s")" && cp "$s" "{run_dir}/$s"; done',
            # A rule with no sources still needs somewhere to run.
            f'mkdir -p "{workdir}"',
        ] + ([
            f'mkdir -p {tool_dir}',
            f'cp -R $SRCS_TOOL/. {tool_dir}/',
        ] if tool_modules else []) + [
            'NODE=$(readlink -f "$TOOLS_NODE")',
            f'BIN=$(readlink -f "$("$PLEASE_JS" resolve-bin --tree {bin_tree} --package {package}' + (f' --bin {bin}' if bin else '') + ')")',
            f'cd "{workdir}" && {env_prefix} "$NODE" "$BIN" ' + " ".join(args) + redirect + status,
            "cd $TMP_DIR",
            f'for o in $OUTS; do cp -R "{workdir}/$o" "$o"; done',
        ]),
        tools = {
            "node": [CONFIG.JS.NODE_TOOL],
            "please_js": [CONFIG.JS.PLEASE_JS_TOOL],
        },
        deps = deps,
        needs_transitive_deps = True,
        visibility = visibility,
        labels = labels,
        test_only = test_only,
        building_description = "Running...",
    )


def _js_run(name, entry_point, deps, node_modules, node_options, test,
            visibility, labels, srcs=[], data=[], runner="", runner_args=[],
            link_srcs=[], link_deps=False, env={}, fixed_args=[],
            chdir="", expected_exit_code=0, timeout=0, flaky=0, size=None):
    """Shared implementation of js_binary and js_test.

    The third-party tree and the first-party libraries are assembled separately
    because they resolve differently: a package from the lockfile lives in the
    store, where two resolutions of it can coexist; a library named by its
    location has nothing to disambiguate. Both land in one directory beside the
    entry point, so node resolves by walking up from the entry to the
    node_modules next to it -- no NODE_PATH and no launcher computing paths.

    That directory is a runtime_deps of the launcher rather than an output of
    it: `plz run` refuses a target with more than one output, and data is staged
    beside the binary for `plz test` but not for `plz run`.
    """
    node_modules = node_modules or CONFIG.JS.NODE_MODULES
    run_dir = "_" + name + "_run"
    # The entry may be a label naming a file some other target produced, in
    # which case splitting the attribute on "/" yields "pkg:main.js" rather than
    # a filename. The staged path is the truth, so the name is read from it.
    entry_name = "main.js"

    # Node's own test runner, which needs nothing installed: it is part of the
    # runtime already pinned, and it writes JUnit natively, which is what Please
    # reads to report tests individually rather than as one pass or fail.
    suite = bool(srcs) and not runner
    # A run directory rather than a single entry file: anything with sources of
    # its own, or a runner that finds its own inputs, works from a directory.
    from_dir = bool(srcs) or bool(runner) or bool(link_srcs)
    # Symlinked at run time rather than copied at build time, so a program that
    # must see later edits sees them. Nothing is written outside plz-out; the
    # links point into the source tree rather than the other way round.
    copy_srcs = bool(srcs)
    strip = package_name() + "/"

    runtime = build_rule(
        name = name,
        tag = "runtime",
        srcs = {
            "entry": [entry_point] if entry_point else [],
            "suite": srcs if copy_srcs else [],
            "modules": [node_modules] if node_modules else [],
        },
        outs = [run_dir],
        cmd = " && ".join([
            'PLEASE_JS=$(readlink -f "$TOOLS_PLEASE_JS")',
            # Every first-party library staged here describes itself, so the set
            # is collected by shape rather than by naming each one twice.
            # lib.json rather than meta.json: a third-party package writes the
            # latter, and the two are placed differently.
            # node_modules is pruned: a staged tree holds no lib.json of its
            # own, and walking it covers the whole dependency set a second time.
            'LIBS=$(find . -name node_modules -prune -o -name lib.json -print | ' +
            'while read m; do printf -- "--lib %s:%s " "$m" "$(dirname "$m")/pkg"; done)',
            # A repo whose first-party code has no third-party dependencies has
            # no tree to overlay onto, and the overlay makes an empty one. The
            # variable is unset rather than empty in that case.
            '"$PLEASE_JS" overlay --tree "${SRCS_MODULES:-}" --out "$OUT/node_modules" $LIBS' +
            (" --dev" if link_deps else ""),
        ] + ([
            # At their own paths, because a test file's relative imports have to
            # keep working and because the reported name should be the file
            # someone wrote, not a flattened one.
            'for s in $SRCS_SUITE; do mkdir -p "$OUT/$(dirname "${s#' + strip + '}")" && ' +
            'cp "$s" "$OUT/${s#' + strip + '}"; done',
        ] if copy_srcs else [] if from_dir else [
            'cp "$SRCS_ENTRY" "$OUT/' + entry_name + '"',  # a fixed name, so a label works
        ])),
        tools = {"please_js": [CONFIG.JS.PLEASE_JS_TOOL]},
        deps = deps,
        needs_transitive_deps = True,
        test_only = test,
    )

    # Runtime deps stage flat beside the launcher, under their output names --
    # not at their package paths, which is where data lands.
    # Please stages a target's dependencies two ways, and a binary meets both.
    # Under `plz run` the working directory is the repo root, non-binary
    # runtime_deps are copied beside the launcher, and a binary dependency is
    # left where it already lives, in plz-out/bin. Under `plz test` the working
    # directory is a staging directory and data lands there at package-relative
    # paths. Neither layout is wrong; they are just different, so the launcher
    # looks for each thing in both places and says so if it finds neither.
    node_rel = _staged_path(CONFIG.JS.NODE_TOOL) + "/bin/node"
    tool_rel = _staged_path(CONFIG.JS.PLEASE_JS_TOOL)
    tool_sub = _subrepo_path(CONFIG.JS.PLEASE_JS_TOOL) or tool_rel
    run_rel = package_name() + "/" + run_dir + "/" + entry_name
    dir_rel = package_name() + "/" + run_dir

    # Exported before exec, single-quoted so a value carrying a space or a
    # dollar reaches the program as written.
    env_lines = [
        "export " + k + "='" + v.replace("'", "'\\''") + "'"
        for k, v in sorted(env.items())
    ]

    # After the paths are resolved, since they are found relative to where the
    # launcher started.
    chdir_lines = [f'cd "$ROOT/{chdir}"'] if chdir else []

    # fixed_args come before the caller's, which is what makes them fixed: a
    # wrapper's own arguments cannot be displaced by whoever runs it.
    call = '"$NODE" @OPTS@ "$MAIN" ' + " ".join(
        ["'" + a.replace("'", "'\\''") + "'" for a in fixed_args]) + ' "$@"'

    # Rebuilt every start, so a source dropped from srcs stops being served
    # rather than lingering as a link nobody declared.
    # Bound here because the build language's f-strings take names, not calls.
    pkg_dir = package_name()
    link_lines = []
    if link_srcs:
        link_lines = ['mkdir -p "$RUNDIR"']
        for src in link_srcs:
            if src.startswith(":") or src.startswith("/"):
                # A label names something a rule produced, which has no place in
                # the source tree to point at.
                fail(f"js_binary {name}: link_srcs cannot link {src}, which is a " +
                     "target rather than a file in this package")
            link_lines += [
                f'mkdir -p "$RUNDIR/$(dirname "{src}")"',
                # Into the source tree, never out of it: the link lives in
                # plz-out and points at the file the developer edits. srcs are
                # written relative to the package, so the package is where the
                # repository-relative path starts.
                f'ln -sfn "$ROOT/{pkg_dir}/{src}" "$RUNDIR/{src}"',
            ]

    if runner:
        pkg, _, bin = runner.partition("|")
        # Resolved at test time from the tree beside the tests, because that is
        # the tree the runner will resolve everything else through -- and
        # resolve-bin says what a package publishes when the name is wrong.
        exec_line = "\n".join([
            'TOOL=$(find_one "$ROOT/@TOOL@" "$ROOT/plz-out/bin/@TOOL@" "$ROOT/plz-out/bin/@TOOLSUB@") || {',
            '    echo "no please_js to find the runner" >&2; exit 1; }',
            f'BIN=$("$TOOL" resolve-bin --tree "$RUNDIR/node_modules" --package {pkg}' +
            (f' --bin {bin}' if bin else '') + ')',
            'BIN=$(cd "$RUNDIR" && readlink -f "$BIN")',
        ] + ([
            # First-party packages, as their sources. Rebuilt every start, so a
            # library removed from deps or a source removed from a library
            # stops being served.
            '"$TOOL" devlink --tree "$RUNDIR/node_modules" --root "$ROOT" --spec "$RUNDIR/devlinks.json"',
        ] if link_deps else []) + [
            # Please may give this relative, and relative to where the launcher
            # started, so it is resolved before anything changes directory.
            'case "${RESULTS_FILE:-}" in',
            '    "") RESULTS="" ;;',
            '    /*) RESULTS="$RESULTS_FILE" ;;',
            '    *) RESULTS="$ROOT/$RESULTS_FILE" ;;',
            "esac",
            # From the run directory: a runner reads its config and finds its
            # tests relative to where it starts.
            # The caller's arguments last, so `plz run //x:dev -- --port 5199`
            # reaches the runner and can override what the rule set.
            f'cd "$RUNDIR" && exec "$NODE" @OPTS@ "$BIN" ' +
            " ".join([_runner_arg(a) for a in runner_args]) + ' "$@"',
        ])
    elif suite:
        # Named individually rather than by directory: node's runner takes paths,
        # and naming them means a file the rule was not given cannot be picked up
        # by accident.
        files = " ".join(['"$RUNDIR"/' + "'" + f + "'" for f in srcs])
        # No cd. Node resolves a relative import from the importing file and
        # walks up from there for node_modules, so the test file's own location
        # is what matters and the working directory is not.
        #
        # Two whole commands rather than a variable holding flags, because a
        # variable would have to expand unquoted to become two arguments.
        exec_line = "\n".join([
            'if [ -n "${RESULTS_FILE:-}" ]; then',
            # Please may give this relative, and relative to the directory the
            # launcher started in.
            '    case "$RESULTS_FILE" in',
            '        /*) RESULTS="$RESULTS_FILE" ;;',
            '        *) RESULTS="$ROOT/$RESULTS_FILE" ;;',
            "    esac",
            '    TOOL=$(find_one "$ROOT/@TOOL@" "$ROOT/plz-out/bin/@TOOL@") || {',
            '        echo "js_test: no please_js to convert results" >&2; exit 1; }',
            # Node writes its own shape first, then it is rewritten: a test not
            # inside a describe lands directly under <testsuites>, where Please
            # does not look, so without this a plain test file reports nothing.
            '    "$NODE" @OPTS@ --test --test-reporter=junit' +
            ' --test-reporter-destination="$ROOT/node.xml" ' + files + ' && status=0 || status=$?',
            f'    "$TOOL" junit --in "$ROOT/node.xml" --out "$RESULTS" --suite {name}',
            '    exit "$status"',
            "else",
            # No results file means a person is reading, so print for them.
            '    exec "$NODE" @OPTS@ --test --test-reporter=spec ' + files,
            "fi",
        ])
    elif expected_exit_code:
        # Inverted: the program is expected to fail, so succeeding is the
        # failure. Only ever set on a test.
        exec_line = "\n".join([
            call + " && status=0 || status=$?",
            f'[ "$status" = "{expected_exit_code}" ] || {{',
            f'    echo "js_test: expected exit {expected_exit_code}, got $status" >&2',
            "    exit 1; }",
        ])
    else:
        exec_line = "exec " + call
    launcher = "\n".join([
        "#!/bin/sh",
        "set -eu",
        "ROOT=$(pwd -P)",
        'HERE=$(cd -- "$(dirname -- "$0")" && pwd -P)',
        "",
        "find_one() {",
        '    for c in "$@"; do',
        '        [ -e "$c" ] && { printf %s "$c"; return 0; }',
        "    done",
        "    return 1",
        "}",
        "",
        'NODE=$(find_one "$ROOT/@NODE@" "$ROOT/plz-out/bin/@NODE@") || {',
        '    echo "js_binary: no node toolchain at @NODE@" >&2; exit 1; }',
        ('RUNDIR=$(find_one "$HERE/@RUNDIR@" "$ROOT/@DIR@" "$ROOT/plz-out/gen/@DIR@") || {'
         if from_dir else
         'MAIN=$(find_one "$HERE/@RUNDIR@/@ENTRY@" "$ROOT/@RUN@" "$ROOT/plz-out/gen/@RUN@") || {'),
        '    echo "js_binary: no runtime directory for this program" >&2; exit 1; }',
        "",
    ] + link_lines + env_lines + chdir_lines + [
        exec_line,
    ])
    launcher = (launcher
        .replace("@NODE@", node_rel)
        .replace("@RUNDIR@", run_dir)
        .replace("@RUN@", run_rel)
        .replace("@DIR@", dir_rel)
        .replace("@TOOLSUB@", tool_sub)
        .replace("@TOOL@", tool_rel)

        .replace("@ENTRY@", entry_name)
        .replace("@OPTS@", " ".join(node_options)))

    return build_rule(
        name = name,
        outs = [name + ".sh"],
        cmd = "cat > $OUT <<'PLZ_LAUNCHER'\n" + launcher + "\nPLZ_LAUNCHER\nchmod +x $OUT",
        # data for the test layout, runtime_deps for the run layout.
        # please_js only for a suite, which is the only mode that has results
        # to convert.
        # please_js resolves a runner's executable and converts node's results,
        # so it is needed whenever either happens -- under both staging layouts,
        # because a binary is reached through runtime_deps and a test through
        # data.
        data = (data + _staged(runtime, suite or bool(runner))) if test else None,
        runtime_deps = None if test else _staged(runtime, suite or bool(runner)),
        binary = True,
        test = test,
        # A suite writes JUnit for Please to read, which is the whole point --
        # without it a target with six tests reports one result.
        no_test_output = test and not suite,
        visibility = visibility,
        labels = labels,
        test_timeout = timeout if test else 0,
        flaky = flaky if test else 0,
        size = size if test else None,
        building_description = "Preparing...",
    )


def _staged_path(label:str):
    """Where a data dependency lands, relative to a binary's own directory.

    A label names a target; data is staged at the target's package path. The
    launcher needs the latter, and deriving it here keeps the generated script
    free of path arithmetic -- which is where every symlink bug in this plugin
    has come from.
    """
    target = label.split("|")[0].lstrip("/")
    # A subrepo label carries its repo ahead of the package, as
    # ///js//third_party/node:node, but data stages at the package path either
    # way, so anything before the last separator is dropped.
    if "//" in target:
        target = target.split("//")[-1]
    package, _, name = target.partition(":")
    return package + "/" + name


def check_package_name(package:str, target:str):
    """Rejects a name node cannot resolve as a package.

    A library is imported by name, and npm's rules for a name are narrower than
    a path: a single segment, or a scope and one segment. CommonJS is lenient
    enough to hide this -- it falls back to walking directories, so
    node_modules/a/b/c resolves -- but ESM is not. There, `a/b/c` means package
    `a`, subpath `./b/c`, and node fails with ERR_UNSUPPORTED_DIR_IMPORT.

    So the Go convention of naming a library after its directory does not carry
    over, and defaulting to the package path is only safe one directory deep.
    Failing here is much cheaper than discovering it the day a library starts
    emitting modules.
    """
    if "/" not in package:
        return
    if package.startswith("@") and package.count("/") == 1:
        return
    parts = package.split("/")
    suggestion = "@" + parts[0] + "/" + "-".join(parts[1:])
    fail(f"{target}: `{package}` is not a package name node can " +
         "resolve. npm allows one segment, or a scope and one segment -- " +
         "CommonJS hides this by falling back to directories, but ESM reads " +
         f"it as a subpath and fails. Set package, for instance `{suggestion}`.")


def npm_package(name:str, lib:str, version:str, fields:dict={}, files:list=[],
                include_types:bool=True, visibility:list=None,
                test_only:bool&testonly=False, labels:list=[]):
    """A publishable npm package, built from a first-party library.

    js_library and ts_library already emit a package: a pkg/ directory with a
    generated package.json beside it. What they do not emit is what a registry
    needs -- a real version, a repository, a licence -- because a library
    consumed inside one repo needs none of it.

    The manifest is patched rather than regenerated. The name, entry point,
    types and exports map were worked out once and are easy to get wrong; the
    exports map especially, since a missing one makes a package unimportable
    under ESM and a mis-ordered one makes its types unreachable. Neither failure
    happens until someone installs it.

    A separate rule rather than more arguments on js_library, because almost no
    library is published and paying for the distinction everywhere to serve the
    few that are is the wrong trade.

    Args:
        name: Target name.
        lib: The js_library or ts_library to package. Its package name is the
             published name -- the one consumers already import it by, so there
             is nothing to restate and nothing to drift.
        version: The version to publish as. Required and deliberately not
                 defaulted: a plausible wrong version is worse than no default.
        fields: Further package.json fields -- repository, license, keywords,
                engines. A value that parses as JSON is written as JSON, so a
                repository can be an object rather than a string that looks
                like one.
        files: Extra files copied in beside the library's own, such as a README
               or a LICENSE, which a registry shows and a build does not need.
        include_types: Keep the .d.ts files.
        visibility: Visibility specification.
        test_only: If True, only visible to test rules.
        labels: Additional labels.
    """
    set_flags = " ".join([
        "--set " + _shell_quote(k + "=" + v) for k, v in sorted(fields.items())
    ])

    return build_rule(
        name = name,
        srcs = {"lib": [lib], "files": files},
        outs = [name],
        cmd = " && ".join([
            # The library's own output, found by shape rather than named: it
            # describes itself, exactly as every consumer of it does.
            'LIB=$(find . -name lib.json -not -path "./$OUT/*" | head -1)',
            'mkdir -p "$OUT"',
            'cp -R "$(dirname "$LIB")/pkg/." "$OUT/"',
            'for f in ${SRCS_FILES:-}; do cp "$f" "$OUT/$(basename "$f")"; done',
        ] + ([] if include_types else [
            'find "$OUT" -name "*.d.ts" -delete',
        ]) + [
            f'"$TOOLS_PLEASE_JS" publish --dir "$OUT" --version {version} {set_flags}',
        ]),
        tools = {"please_js": [CONFIG.JS.PLEASE_JS_TOOL]},
        deps = [lib],
        visibility = visibility,
        test_only = test_only,
        labels = labels + ["npm_package"],
        building_description = "Packaging...",
    )


def _shell_quote(v:str):
    """Single-quotes a value so a shell will not reinterpret it."""
    return "'" + v.replace("'", "'\\''") + "'"


def _runner_arg(arg:str):
    """Quotes a runner flag, leaving $RESULTS_FILE as the one thing that expands.

    Everything else is literal, because a flag carrying a space or a dollar
    should reach the runner as written. The results path is the exception: it
    is only known at test time, so a reporter has to be pointed at it by name.
    """
    quote = lambda part: "'" + part.replace("'", "'\\''") + "'"
    return '"$RESULTS"'.join([quote(part) for part in arg.split("$RESULTS_FILE")])


def _staged(runtime:str, needs_tool:bool):
    """What a launcher needs beside it, whichever way Please stages it."""
    out = [runtime, CONFIG.JS.NODE_TOOL.split("|")[0]]
    if needs_tool:
        out += [CONFIG.JS.PLEASE_JS_TOOL.split("|")[0]]
    return out


def _subrepo_path(label:str):
    """Where a subrepo's binary sits under plz-out/bin.

    Data staging drops the subrepo -- a target from ///js// lands at its package
    path like any other -- but plz-out/bin keeps it, so a plugin's own tool is
    at plz-out/bin/js/tools/please_js/please_js. Both are right for their
    layout, so the launcher tries both rather than guessing which it is in.

    Returns an empty string for a label with no subrepo, where the two forms are
    the same path.
    """
    target = label.split("|")[0].lstrip("/")
    if "//" not in target:
        return ""
    repo, _, rest = target.partition("//")
    package, _, name = rest.partition(":")
    return repo + "/" + package + "/" + (name or package.split("/")[-1])
