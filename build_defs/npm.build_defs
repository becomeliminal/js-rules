"""npm dependencies as a pnpm-style symlinked package store.

Every package version lives once, at a path keyed by its identity, and
everything needing it is a symlink into that one copy. Node's resolution walks
up node_modules directories, so a package placed at <store>/node_modules/<pkg>
with its dependencies as siblings resolves correctly with no resolver hook --
which is what lets npm-provided tools, which do their own resolution, run
unchanged.

    node_modules/
    |-- <pkg> -> .plz/<entry>/node_modules/<pkg>        the "link"
    `-- .plz/
        `-- <entry>/node_modules/
            |-- <pkg>/                                   real files
            `-- <dep> -> ../../<dep-entry>/node_modules/<dep>

The rules stay thin. Every path in that tree is relative and several depend on
how deeply a name nests, so the arithmetic lives in please_js where it is
tested, not in a shell command where it is not.
"""


def _env_prefix(env:dict):
    """Renders an environment as assignments a shell will not reinterpret.

    Single-quoted, so a value containing a space, a dollar or a backtick reaches
    the command as written. The inner replacement is the standard way to carry a
    single quote through single quotes: close, escape one, reopen.
    """
    return " ".join([
        k + "='" + v.replace("'", "'\\''") + "'" for k, v in sorted(env.items())
    ])


def npm_repo(name:str, pkg:str="", version:str="", hashes:list=None,
             os:list=[], cpu:list=[], postinstall:str="", postinstall_env:dict={},
             visibility:list=["PUBLIC"], labels:list=[]):
    """One npm package version, fetched and described.

    One rule per package, as go_repo and rust_repo do, and with the same small
    surface: what to fetch and what it should hash to.

    There is deliberately no deps argument. Which packages this one needs, and
    the names it imports them under, are already recorded in the lockfile, and
    npm_link reads it -- so nothing is restated here and there is nothing to
    keep in sync. It also keeps the build graph sparse, which matters: carrying
    the dependency closure through exported_deps is what made a warm build take
    50s instead of 270ms in the previous implementation.

    Args:
        name: Target name, and the entry's identity in the store. The generator
              folds any peer resolution into it and Please enforces uniqueness,
              so two resolutions of one package cannot collide.
        pkg: npm package name. Defaults to name.
        version: Exact version to fetch.
        hashes: Download hashes. A lockfile's integrity is sha512 and Please
                verifies sha1 or sha256, so please_js update records a sha256 it
                computed while checking the sha512.
        os: Operating systems the package supports; empty means any.
        cpu: Architectures it supports; empty means any.

            Every fast JavaScript tool now ships as a small wrapper plus one
            native binary per platform -- TypeScript 7 has twenty, at ~28MB
            each -- so a tree that fetched them all would carry hundreds of
            megabytes of compilers that cannot run here. A package excluded by
            its constraints still gets a target, so the build file is the same
            on every platform, but nothing is fetched and nothing is placed.
        postinstall: A command run inside the fetched package after extraction
                     and before it is described, with the package directory as
                     its working directory and the node toolchain on PATH.

            This is the deliberate half of what npm calls a lifecycle hook: a
            command this repo chose, not one the package brought with it.
            Nothing runs unless it is written here, which is the property worth
            keeping -- a package's own install script is arbitrary code from a
            third party, and running it because the package asked is how a
            supply chain attack succeeds.
        postinstall_env: Environment for that command. Only what is named here
                         is set; the build's own environment is not inherited,
                         so a command cannot quietly depend on the machine.
        visibility: Visibility specification.
        labels: Additional labels.
    """
    pkg = pkg or name
    if not version:
        fail(f"npm_repo {name}: version is required")

    if not _supported(os, cpu):
        return build_rule(
            name = name,
            outs = [name],
            cmd = " && ".join([
                'mkdir -p "$OUT"',
                " ".join([
                    "$TOOLS_TOOL describe",
                    f"--name {name} --package {pkg} --version {version}",
                    " ".join([f"--os {o}" for o in os]),
                    " ".join([f"--cpu {c}" for c in cpu]),
                    '--out "$OUT/meta.json"',
                ]),
            ]),
            tools = {"tool": [CONFIG.JS.PLEASE_JS_TOOL]},
            visibility = visibility,
            labels = labels + [f"npm:{pkg}@{version}", "npm_unsupported"],
            building_description = "Skipping (other platform)...",
        )

    # Rendered here because the build language's f-strings take names, not calls.
    hook_env = _env_prefix(postinstall_env)

    # Scoped packages live at @scope/name/-/name-version.tgz: the scope is in
    # the path but not in the tarball filename.
    basename = pkg.split("/")[-1]

    download = remote_file(
        name = tag(name, "download"),
        url = f"{CONFIG.JS.NPM_REGISTRY}/{pkg}/-/{basename}-{version}.tgz",
        out = tag(name, "tgz"),
        hashes = hashes,
        extract = True,
    )

    return build_rule(
        name = name,
        srcs = [download],
        outs = [name],
        cmd = " && ".join([
            # An npm tarball conventionally holds a single package/ directory,
            # but the convention is not universal: DefinitelyTyped ships
            # @types/node rooted at "node v22.18", space and all. So the root is
            # discovered rather than assumed -- package/ when it is there, the
            # sole top-level directory when it is not, and the tarball itself
            # when it has no wrapper at all.
            'mkdir -p "$OUT/pkg"',
            'if [ -d "$SRCS/package" ]; then ROOT="$SRCS/package";' +
            ' elif [ "$(ls -1 "$SRCS" | wc -l)" = 1 ] && [ -d "$SRCS/$(ls -1 "$SRCS")" ];' +
            ' then ROOT="$SRCS/$(ls -1 "$SRCS")"; else ROOT="$SRCS"; fi',
            'cp -R "$ROOT/." "$OUT/pkg/"',
        ] + ([
            # Before describe, so a command that writes a bin/ or a
            # package.json field is reflected in what the store records.
            #
            # node is put on PATH rather than passed as a variable because an
            # install script is written to be run by npm, and npm puts it there.
            # Anything else means editing every script that shells out to node.
            'NODEDIR=$(dirname "$(readlink -f "$TOOLS_NODE")")',
            f'cd "$OUT/pkg" && PATH="$NODEDIR:$PATH" {hook_env} {postinstall}',
            'cd "$TMP_DIR"',
        ] if postinstall else []) + [
            " ".join([
                "$TOOLS_TOOL describe",
                f"--name {name} --package {pkg} --version {version}",
                '--dir "$OUT/pkg" --out "$OUT/meta.json"',
            ]),
        ]),
        tools = {"tool": [CONFIG.JS.PLEASE_JS_TOOL]} if not postinstall else {
            "tool": [CONFIG.JS.PLEASE_JS_TOOL],
            # Only when something will run: an npm_repo that just unpacks a
            # tarball has no reason to depend on a toolchain.
            "node": [CONFIG.JS.NODE_TOOL],
        },
        visibility = visibility,
        labels = labels + [f"npm:{pkg}@{version}"],
        building_description = "Fetching npm package...",
    )


def npm_link(name:str, lock:str, packages:list, project:str=".",
             visibility:list=["PUBLIC"]):
    """Assembles a node_modules tree for one pnpm workspace project.

    This is the JavaScript equivalent of go-rules aggregating .importconfig
    fragments, with one difference that shapes everything: `go tool compile` and
    rustc accept a resolution table as a flag, and node does not. Node resolves
    only by walking the filesystem, so the table has to *be* the directory. That
    is why the tree is built rather than a config file written, and why it is
    the interface every layer above this one consumes.

    Args:
        name: Target name; the output directory is the node_modules root.
        lock: The pnpm lockfile. The graph is read from here rather than
              restated across the npm_repo rules.
        packages: Every entry in the project's transitive closure, as labels.
                  An entry reachable only through another package's dependency
                  link still has to be staged, or that link dangles -- and the
                  closure cannot come from the build graph: needs_transitive_deps
                  stages only direct srcs, and carrying it through exported_deps
                  is what made a warm build take 50s instead of 270ms.
        project: Which project in the pnpm workspace this tree is for.
        visibility: Visibility specification.
    """
    srcs = {"lock": [lock]}
    source_flags = []
    for i, target in enumerate(packages):
        srcs[f"s{i}"] = [target]
        source_flags += [f'--source "$SRCS_S{i}/meta.json:$SRCS_S{i}/pkg"']

    return build_rule(
        name = name,
        srcs = srcs,
        outs = [name],
        cmd = " ".join([
            '$TOOL link --out "$OUT" --lock "$SRCS_LOCK"',
            f"--project {project}",
        ] + source_flags),
        tools = {"tool": [CONFIG.JS.PLEASE_JS_TOOL]},
        visibility = visibility,
        building_description = "Linking node_modules...",
    )


def _supported(os:list, cpu:list):
    """Whether a package's npm platform constraints admit this machine.

    Please spells the architecture the way Go does and npm does not: amd64
    against x64. The operating system agrees.
    """
    arch = "x64" if CONFIG.ARCH == "amd64" else CONFIG.ARCH
    return _admits(os, CONFIG.OS) and _admits(cpu, arch)


def _admits(constraints:list, actual:str):
    """Whether a constraint list admits a value.

    Empty admits anything. A list of negations reads as a denylist; any
    positive entry makes it an allowlist.
    """
    if not constraints:
        return True
    denied = False
    allowed = False
    positive = False
    for c in constraints:
        if c.startswith("!"):
            if c[1:] == actual:
                denied = True
        else:
            positive = True
            if c == actual:
                allowed = True
    if denied:
        return False
    return allowed or not positive
