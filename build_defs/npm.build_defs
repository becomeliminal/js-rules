"""npm dependencies as a pnpm-style symlinked package store.

Every package version lives once, at a path keyed by the resolution that
produced it, and everything needing it is a symlink into that one copy. Node's
resolution walks up node_modules directories, so a package placed at
<store>/node_modules/<pkg> with its dependencies as siblings resolves correctly
with no resolver hook -- which is what lets npm-provided tools, which do their
own resolution, run unchanged.

    node_modules/
    |-- <pkg> -> .plz/<key>/node_modules/<pkg>          the "link"
    `-- .plz/
        `-- <key>/node_modules/
            |-- <pkg>/                                   real files
            `-- <dep> -> ../../<depkey>/node_modules/<dep>

The rules here stay deliberately thin. Every path in that tree is relative and
several depend on how deeply an alias nests, so the arithmetic lives in
please_js where it is tested, not in a shell command where it is not.
"""


def npm_repo(name:str, pkg:str="", version:str="", key:str="", deps:dict={},
             hashes:list=None, visibility:list=["PUBLIC"], labels:list=[]):
    """One npm package version, fetched and described.

    One rule per package, as go_repo and rust_repo do: per-package
    configuration is a rule argument rather than an entry in a dict on a rule
    that owns the whole lockfile.

    The rule fetches and describes; it does not shape the store. What a package
    is -- its name, version, resolution key, dependencies and executables -- is
    recorded beside it, and npm_link assembles trees from those descriptions.

    Args:
        name: Target name.
        pkg: npm package name. Defaults to name.
        version: Exact version to fetch.
        key: Store key. Defaults to pkg@version. Pass the resolution-carrying
             key where a package's dependencies change its identity, so two
             resolutions of one package coexist.
        deps: Map of import name -> npm_repo target it resolves to.
        hashes: Download hashes. A lockfile's integrity is sha512 and Please
                verifies sha1 or sha256, so please_js update records a sha256
                it computed while checking the sha512.
        visibility: Visibility specification.
        labels: Additional labels.
    """
    pkg = pkg or name
    if not version:
        fail(f"npm_repo {name}: version is required")
    key = key or f"{pkg}@{version}"

    # Scoped packages live at @scope/name/-/name-version.tgz: the scope is in
    # the path but not in the tarball filename.
    basename = pkg.split("/")[-1]

    download = remote_file(
        name = tag(name, "download"),
        url = f"{CONFIG.JS.NPM_REGISTRY}/{pkg}/-/{basename}-{version}.tgz",
        out = tag(name, "tgz"),
        hashes = hashes,
        extract = True,
    )

    srcs = {"pkg": [download]}
    dep_flags = []
    for i, alias in enumerate(sorted(deps.keys())):
        srcs[f"d{i}"] = [deps[alias]]
        dep_flags += [f'--dep "{alias}=$(cat $SRCS_D{i}/key)"']

    return build_rule(
        name = name,
        srcs = srcs,
        deps = [deps[alias] for alias in sorted(deps.keys())],
        outs = [name],
        cmd = " && ".join([
            # npm tarballs extract to a package/ directory.
            'mkdir -p "$OUT/pkg"',
            'cp -R "$SRCS_PKG/package/." "$OUT/pkg/"',
            # The key is exposed as a file so a dependent can name it without
            # the rule having to be told its dependencies' keys twice.
            f'printf %s "{key}" > "$OUT/key"',
            " ".join([
                "$TOOL describe",
                f'--package "{pkg}" --version "{version}" --key "{key}"',
                '--dir "$OUT/pkg" --out "$OUT/meta.json"',
            ] + dep_flags),
        ]),
        tools = {"tool": [CONFIG.JS.PLEASE_JS_TOOL]},
        visibility = visibility,
        labels = labels + [f"npm:{pkg}@{version}"],
        building_description = "Fetching npm package...",
    )


def npm_link(name:str, packages:dict, store:list=[], visibility:list=["PUBLIC"]):
    """Assembles a node_modules tree from npm_repo targets.

    Args:
        name: Target name; the output directory is the node_modules root.
        packages: Map of import name -> npm_repo target to link at top level.
                  The import name is not always the package name: a lockfile
                  can bind one package under several aliases at once.
        store: Every npm_repo target in the transitive closure, including those
               not linked at top level.

               This is passed explicitly rather than derived. needs_transitive_deps
               stages only direct srcs, so an entry reachable only through
               another package's dependency link never lands and that link
               dangles; exported_deps would carry the closure and is what
               produced the hash oscillation and 100x warm-cache slowdown in the
               previous implementation. Computing it is the resolver's job, as
               npm_link_all_packages does in aspect_rules_js.
        visibility: Visibility specification.
    """
    srcs = {}
    source_flags = []
    for i, target in enumerate(store):
        srcs[f"s{i}"] = [target]
        source_flags += [f'--source "$SRCS_S{i}/meta.json:$SRCS_S{i}/pkg"']

    link_flags = []
    for i, alias in enumerate(sorted(packages.keys())):
        srcs[f"p{i}"] = [packages[alias]]
        link_flags += [f'--link "{alias}=$(cat $SRCS_P{i}/key)"']

    return build_rule(
        name = name,
        srcs = srcs,
        outs = [name],
        cmd = " ".join(['$TOOL link --out "$OUT"'] + source_flags + link_flags),
        tools = {"tool": [CONFIG.JS.PLEASE_JS_TOOL]},
        visibility = visibility,
        building_description = "Linking node_modules...",
    )
